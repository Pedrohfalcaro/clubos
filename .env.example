# Firebase — ClubOS (Google Auth + cloud save)
# Copie para .env e preencha com o console do Firebase:
# https://console.firebase.google.com → Project settings → Your apps

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API-Football (api-sports.io) — busca de atletas em Transferências
# https://www.api-football.com/ → dashboard → API key
VITE_API_FOOTBALL_KEY=
